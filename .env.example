# Application Settings
APP_NAME=keuangan-mobile-app
APP_VERSION=1.0.0
ENVIRONMENT=development

# User Preferences
DEFAULT_CURRENCY=IDR
DEFAULT_LANGUAGE=id
DEFAULT_THEME=light

# AI On-Device Model Configuration (Offline Gemma 4 E2B / Gemma 2B GGUF)
EXPO_PUBLIC_HF_MODEL_URL=https://huggingface.co/bartowski/gemma-2-2b-it-GGUF/resolve/main/gemma-2-2b-it-Q4_K_M.gguf
EXPO_PUBLIC_HF_MODEL_FILENAME=gemma-2-2b-it-Q4_K_M.gguf

# Gemini AI Configuration (fallback cloud key; the app Settings screen can override per device)
EXPO_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here

# Firebase Configuration (public values; protected by Firestore security rules)
# Register a Web app in Firebase console: Project settings > Your apps > Add app
EXPO_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=1:your_sender_id:web:your_web_app_id

# Compatibility
EXPO_ROUTER_DISABLE_RN_NAVIGATION_CHECK=1
